---
import "../styles/global.css";
import { theme, profile, site, contact, socials, skills } from "../data/portfolio.js";
import Nav from "../components/Nav.astro";

const { navItems = [], pageTitle, pageDescription, noindex = false } = Astro.props;

const title = pageTitle || site.title;
const description = pageDescription || site.description;
const lang = site.language || "en";

// On GitHub Pages the site can live in a sub-folder, so every asset path has
// to be prefixed. BASE_URL is "/" normally, or "/your-repo/" when base is set.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (path) => `${base}${path}`;

// Absolute URLs for the social tags. Crawlers reject relative ones, so these
// only appear once you have filled in `url` in src/data/portfolio.js.
const origin = Astro.site;
const canonical = origin ? new URL(`${base}/`, origin).href : undefined;
const ogImage = origin ? new URL(asset(site.ogImage || "/og.png"), origin).href : undefined;
const photoUrl = origin && profile.photo ? new URL(asset(profile.photo), origin).href : undefined;

// Structured data: this is what lets Google show you as a person rather than
// just a page. Empty fields are dropped so nothing ships half-filled.
const jsonLd = Object.fromEntries(
  Object.entries({
    "@context": "https://schema.org",
    "@type": "Person",
    name: profile.name,
    jobTitle: profile.role,
    description: site.description,
    email: contact.email ? `mailto:${contact.email}` : undefined,
    url: canonical,
    image: photoUrl,
    homeLocation: profile.location
      ? { "@type": "Place", name: profile.location }
      : undefined,
    alumniOf: profile.college
      ? { "@type": "CollegeOrUniversity", name: profile.college }
      : undefined,
    knowsAbout: skills.flatMap((group) => group.items),
    sameAs: socials.map((social) => social.url).filter(Boolean),
  }).filter(([, value]) =>
    value !== undefined && value !== "" && !(Array.isArray(value) && value.length === 0),
  ),
);

const accentCss = `:root{--accent:${theme.accent};}[data-theme="dark"]{--accent:${theme.accentDark || theme.accent};}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />

    {/* Open Graph — WhatsApp, LinkedIn, Facebook, Slack, Discord */}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang.replace("-", "_")} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
      </>
    )}
    {profile.name.split(" ")[0] && <meta property="profile:first_name" content={profile.name.split(" ")[0]} />}

    {/* Twitter / X */}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={`${profile.name} — ${profile.role}`} />}

    {/* Icons and install metadata */}
    <link rel="icon" href={asset("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={asset("/favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset("/apple-touch-icon.png")} />
    <link rel="manifest" href={asset("/manifest.webmanifest")} />
    <meta name="apple-mobile-web-app-title" content={profile.shortName || profile.name} />
    <meta name="theme-color" content="#FBFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D0C0B" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

    <style is:global set:html={accentCss}></style>

    {/* Runs before paint: no flash of the wrong theme, and it marks the
        page as JavaScript-capable so the reveal animations can hide things. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var saved = localStorage.getItem("theme");
          var wantsDark =
            saved === "dark" ||
            (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
          root.setAttribute("data-theme", wantsDark ? "dark" : "light");
        } catch (e) {
          root.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

<body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="scroll-progress" aria-hidden="true"><span></span></div>

    <Nav navItems={navItems} />

    <main id="main">
      <slot />
    </main>

    <script>
      // ---- Reveal on scroll -------------------------------------------------
      const revealables = document.querySelectorAll("[data-reveal]");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );
        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add("is-in"));
      }

      // ---- Scroll progress bar ---------------------------------------------
      const bar = document.querySelector(".scroll-progress span");
      const nav = document.querySelector(".site-nav");
      let ticking = false;

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? window.scrollY / max : 0;
          if (bar) bar.style.transform = `scaleX(${ratio})`;
          if (nav) nav.classList.toggle("is-stuck", window.scrollY > 24);
          ticking = false;
        });
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // ---- Which section am I in? ------------------------------------------
      const links = Array.from(document.querySelectorAll("[data-nav-link]"));
      const sections = links
        .map((link) => document.querySelector(link.getAttribute("href")))
        .filter(Boolean);

      if (sections.length && "IntersectionObserver" in window) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const id = entry.target.id;
              links.forEach((link) =>
                link.toggleAttribute("data-active", link.getAttribute("href") === `#${id}`),
              );
            }
          },
          { rootMargin: "-45% 0px -50% 0px" },
        );
        sections.forEach((section) => spy.observe(section));
      }

      // ---- Copy email -------------------------------------------------------
      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const value = button.getAttribute("data-copy");
          try {
            await navigator.clipboard.writeText(value);
          } catch (e) {
            return;
          }
          button.classList.add("is-copied");
          window.setTimeout(() => button.classList.remove("is-copied"), 1800);
        });
      });
    </script>

    <style>
      .skip {
        position: absolute;
        left: 50%;
        top: 0;
        transform: translate(-50%, -140%);
        z-index: 300;
        padding: 0.7rem 1.2rem;
        border-radius: 0 0 0.75rem 0.75rem;
        background: var(--ink);
        color: var(--bg);
        font-size: 0.875rem;
        transition: transform 0.3s var(--ease-out);
      }

      .skip:focus-visible { transform: translate(-50%, 0); }

      .scroll-progress {
        position: fixed;
        inset: 0 0 auto 0;
        height: 2px;
        z-index: 120;
        pointer-events: none;
      }

      .scroll-progress span {
        display: block;
        height: 100%;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
      }
    </style>
  </body>
</html>
