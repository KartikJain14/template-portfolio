---
// The strip of words that scrolls under the hero.
// It reuses the "title" of each quality, so there is nothing extra to fill in.
const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => (
        <div class="ticker__group">
          {items.map((item) => (
            <span class="ticker__item">
              {item}
              <span class="ticker__dot"></span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .ticker {
    position: relative;
    padding-block: clamp(1rem, 2.5vw, 1.4rem);
    border-block: 1px solid var(--line);
    background: var(--bg-soft);
    overflow: hidden;
    /* Fade the words out at both edges instead of cutting them. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: scroll 38s linear infinite;
  }

  /* Two identical groups sit side by side and the track slides left by exactly
     one group, so the second lands where the first began and the loop is
     seamless. Each group is forced to at least a full screen wide — otherwise
     a short list runs out before the slide finishes and leaves a visible gap. */
  .ticker__group {
    display: flex;
    flex: none;
    min-width: 100vw;
    justify-content: space-around;
  }

  .ticker:hover .ticker__track { animation-play-state: paused; }

  @keyframes scroll {
    to { transform: translateX(-50%); }
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-right: clamp(1.5rem, 4vw, 3rem);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3.5vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--ink-2);
  }

  .ticker__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--accent);
    flex: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; }
    .ticker { -webkit-mask-image: none; mask-image: none; }
  }
</style>
