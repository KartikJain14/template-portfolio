---
const { id, index, label, title, lead, align = "start" } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <header class={`sec-head sec-head--${align}`} data-reveal>
      <h2 class="h2 sec-head__title">{title}</h2>
      {lead && <p class="lead sec-head__lead">{lead}</p>}
    </header>

    <slot />
  </div>
</section>

<style>
  .sec-head { margin-bottom: clamp(2.5rem, 6vw, 4rem); }

  .sec-head__title { max-width: 20ch; }

  .sec-head__lead {
    max-width: 52ch;
    margin-top: 1.1rem;
  }

  .sec-head--center {
    text-align: center;
  }

  .sec-head--center .sec-head__title,
  .sec-head--center .sec-head__lead {
    margin-inline: auto;
  }
</style>
