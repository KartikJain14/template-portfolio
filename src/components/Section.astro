---
const { id, index, label, title, lead, align = "start" } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <header class={`sec-head sec-head--${align}`} data-reveal>
      <div class="sec-head__label">
        <span class="sec-head__num">{String(index).padStart(2, "0")}</span>
        <span class="eyebrow">{label}</span>
        <span class="sec-head__rule"></span>
      </div>

      <h2 class="h2 sec-head__title">{title}</h2>
      {lead && <p class="lead sec-head__lead">{lead}</p>}
    </header>

    <slot />
  </div>
</section>

<style>
  .sec-head { margin-bottom: clamp(2.5rem, 6vw, 4rem); }

  .sec-head__label {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: clamp(1rem, 2.5vw, 1.5rem);
  }

  .sec-head__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .sec-head__rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .sec-head__title { max-width: 20ch; }

  .sec-head__lead {
    max-width: 52ch;
    margin-top: 1.1rem;
  }

  .sec-head--center {
    text-align: center;
  }

  .sec-head--center .sec-head__title,
  .sec-head--center .sec-head__lead {
    margin-inline: auto;
  }
</style>
