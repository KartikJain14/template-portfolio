---
import { profile } from "../data/portfolio.js";

const { navItems = [] } = Astro.props;

const initials = profile.name
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<header class="site-nav">
  <div class="site-nav__inner container">
    <a class="brand" href="#top" aria-label={`${profile.name} — back to top`}>
      <span class="brand__mark">{initials}</span>
      <span class="brand__name">{profile.shortName || profile.name}</span>
    </a>

    <nav class="site-nav__links" aria-label="Sections">
      {navItems.map((item) => (
        <a href={`#${item.id}`} data-nav-link>{item.label}</a>
      ))}
    </nav>

    <div class="site-nav__actions">
      <button class="icon-btn theme-toggle" type="button" aria-label="Switch colour theme">
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.6v2.2M12 19.2v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" />
        </svg>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.6 8.6 0 1 0 10.8 10.8Z" />
        </svg>
      </button>

      {navItems.length > 0 && (
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
          Menu
        </button>
      )}
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <button class="mobile-menu__close" type="button" aria-label="Close menu">×</button>

    <nav class="mobile-menu__links" aria-label="Sections">
      {navItems.map((item, i) => (
        <a href={`#${item.id}`} style={`--i:${i}`}>
          <span class="mobile-menu__num">{String(i + 1).padStart(2, "0")}</span>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector(".site-nav");
  const menuToggle = document.querySelector(".menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const closeButton = document.querySelector(".mobile-menu__close");

  function setMenu(open) {
    if (!nav || !menuToggle || !menu) return;
    nav.classList.toggle("is-open", open);
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.documentElement.style.overflow = open ? "hidden" : "";
    document.body.style.overflow = open ? "hidden" : "";
    if (open) {
      menu.hidden = false;
    } else {
      window.setTimeout(() => {
        if (!nav.classList.contains("is-open")) menu.hidden = true;
      }, 300);
    }
  }

  menuToggle?.addEventListener("click", () => {
    setMenu(!nav?.classList.contains("is-open"));
  });

      // Nothing below runs when there is no menu button (for example on the 404 page).

  closeButton?.addEventListener("click", () => setMenu(false));

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  window.matchMedia("(min-width: 62rem)").addEventListener("change", (event) => {
    if (event.matches) setMenu(false);
  });

  // Theme toggle
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {
      /* private browsing — the choice just will not be remembered */
    }
  });
</script>

<style>
  .site-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: max(0.85rem, env(safe-area-inset-bottom));
    z-index: 110;
    pointer-events: none;
  }

  @media (min-width: 62rem) {
    .site-nav {
      top: 0.85rem;
      bottom: auto;
    }
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    width: min(calc(100% - 1.5rem), 34rem);
    min-height: 3.5rem;
    pointer-events: auto;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    padding: 0.45rem 0.55rem;
  }

  @media (min-width: 62rem) {
    .site-nav__inner {
      width: min(calc(100% - 3rem), var(--container));
      gap: 1.25rem;
    }
  }

  /* Brand ------------------------------------------------------------ */

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    min-width: 0;
  }

  .brand__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #000;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    transition: transform 0.4s var(--ease-out), background-color 0.3s var(--ease);
  }

  .brand:hover .brand__mark {
    transform: scale(1.06);
    background: #000;
  }

  /* Desktop links ---------------------------------------------------- */

  .site-nav__links {
    display: none;
    gap: 0.35rem;
  }

  .site-nav__links a {
    position: relative;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 0.25s var(--ease), background-color 0.25s var(--ease);
  }

  .site-nav__links a:hover { color: var(--ink); }

  .site-nav__links a[data-active] {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }

  @media (min-width: 62rem) {
    .site-nav__links { display: flex; }
  }

  /* Buttons ---------------------------------------------------------- */

  .site-nav__actions { display: flex; align-items: center; gap: 0.4rem; }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease),
                transform 0.25s var(--ease-out);
  }

  .icon-btn:hover { border-color: var(--ink); transform: translateY(-1px); }
  .icon-btn svg { width: 1.05rem; height: 1.05rem; }

  .theme-toggle { position: relative; }

  .theme-toggle svg {
    position: absolute;
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease-out);
  }

  .theme-toggle__moon { opacity: 0; transform: rotate(-60deg) scale(0.6); }

  :global([data-theme="dark"]) .theme-toggle__sun { opacity: 0; transform: rotate(60deg) scale(0.6); }
  :global([data-theme="dark"]) .theme-toggle__moon { opacity: 1; transform: none; }

  /* Hamburger -------------------------------------------------------- */

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.2rem;
    height: 2.4rem;
    padding-inline: 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--ink);
    color: var(--bg);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: transform 0.25s var(--ease-out), background-color 0.25s var(--ease);
  }

  .menu-toggle:hover { transform: translateY(-1px); }

  @media (min-width: 62rem) {
    .menu-toggle { display: none; }
  }

  /* Mobile menu ------------------------------------------------------ */

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: grid;
    align-content: center;
    min-height: 100svh;
    padding: clamp(1.25rem, 5vw, 2rem);
    padding-bottom: calc(6.25rem + env(safe-area-inset-bottom));
    overflow: auto;
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease-out);
    pointer-events: auto;
  }

  .mobile-menu[hidden] { display: none; }

  .site-nav.is-open .mobile-menu {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__close {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 1.8rem;
    line-height: 1;
  }

  .mobile-menu__links {
    display: grid;
    gap: 0.35rem;
    width: min(100%, 28rem);
    margin-inline: auto;
    padding: 0;
  }

  .mobile-menu__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.15rem, 6vw, 1.55rem);
    letter-spacing: 0;
    opacity: 0;
    transform: translateY(0.75rem);
  }

  .site-nav.is-open .mobile-menu__links a {
    animation: menu-in 0.5s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 0.055s + 0.06s);
  }

  .mobile-menu__num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
  }

  @keyframes menu-in {
    to { opacity: 1; transform: none; }
  }

  @media (min-width: 62rem) {
    .mobile-menu { display: none; }
  }
</style>
