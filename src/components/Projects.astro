---
import { projects } from "../data/portfolio.js";
---

<div class="projects">
  {projects.map((project, i) => (
    <article class="proj" data-reveal>
      <div class="proj__media">
        {project.image ? (
          <img src={project.image} alt={project.title} loading="lazy" width="960" height="720" />
        ) : (
          <div class="proj__placeholder" aria-hidden="true">
            <span class="proj__letter">{project.title.trim().charAt(0).toUpperCase()}</span>
          </div>
        )}
      </div>

      <div class="proj__body">
        <div class="proj__meta">
            {project.year && <span class="eyebrow">{project.year}</span>}
        </div>

        <h3 class="proj__title">{project.title}</h3>
        <p class="proj__blurb">{project.blurb}</p>

        {project.tags?.length > 0 && (
          <ul class="proj__tags">
            {project.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
        )}

        {(project.link || project.code) && (
          <div class="proj__links">
            {project.link && (
              <a class="proj__link" href={project.link} target="_blank" rel="noopener">
                Visit site
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </a>
            )}
            {project.code && (
              <a class="proj__link" href={project.code} target="_blank" rel="noopener">
                Source code
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .projects {
    display: grid;
    gap: clamp(2.4rem, 5.5vw, 4rem);
  }

  .proj {
    display: grid;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 55rem) {
    .proj { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }

    /* Flip every second project so the page zig-zags. */
    .proj:nth-child(even) .proj__media { order: 2; }
  }

  /* Media ---------------------------------------------------------------- */

  .proj__media {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--bg-soft);
    box-shadow: var(--shadow-sm);
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }

  .proj:hover .proj__media {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .proj__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .proj:hover .proj__media img { transform: scale(1.035); }

  /* Shown when no image was set — a deliberate panel, not an empty box. */
  .proj__placeholder {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: var(--bg-soft);
  }

  .proj__letter {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.8rem, 10vw, 5.8rem);
    line-height: 1;
    color: var(--ink);
    opacity: 0.85;
    transition: transform 0.7s var(--ease-out);
  }

  .proj:hover .proj__letter { transform: scale(1.06); }

  /* Body ------------------------------------------------------------------ */

  .proj__meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.55rem;
  }

  .proj__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.55rem, 1.25rem + 1.25vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .proj__blurb {
    margin-top: 0.65rem;
    max-width: 48ch;
    color: var(--ink-2);
    line-height: 1.55;
    letter-spacing: 0.012em;
    text-wrap: pretty;
  }

  .proj__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .proj__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.15rem;
    margin-top: 1.15rem;
  }

  .proj__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.25s var(--ease);
  }

  .proj__link::before {
    content: "-";
    color: var(--muted);
  }

  .proj__link svg {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.35s var(--ease-out);
  }

  .proj__link:hover { color: var(--accent); }
  .proj__link:hover svg { transform: translate(2px, -2px); }
</style>
